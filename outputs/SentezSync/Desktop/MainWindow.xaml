<Window x:Class="SentezSync.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SentezSync — Merkez Yönetimi" Width="1280" Height="850" MinWidth="1000" MinHeight="700" Background="#F1F5F9" Foreground="#172B4D" WindowStartupLocation="CenterScreen">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,20"><StackPanel><TextBlock Text="SentezSync" FontSize="30" FontWeight="Bold"/><TextBlock Text="Tek yönlü veri yönetimi  •  Şirket 7" FontSize="14" Margin="0,5,0,0"/></StackPanel><Border HorizontalAlignment="Right" Background="#FFF0CD" Padding="14,8" CornerRadius="6"><TextBlock Text="ÖN İNCELEME SÜRÜMÜ • SQL yazma kapalı" VerticalAlignment="Center"/></Border></Grid>
  <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="18" Margin="0,0,0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="RouteText" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="StateText" Margin="0,8,0,0" Text="Otomatik izleme kapalı"/><TextBlock x:Name="LastRunText" Margin="0,4,0,0" Foreground="#64748B"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="RunButton" Content="Şimdi karşılaştır" Click="Run_Click"/><Button x:Name="StartButton" Content="İzlemeyi başlat" Click="Start_Click" Background="#147D64" Foreground="White"/><Button x:Name="StopButton" Content="Durdur" Click="Stop_Click" IsEnabled="False"/></StackPanel></Grid></Border>
  <TabControl x:Name="MainTabs" Grid.Row="2" Background="White" BorderThickness="0">
   <TabItem Header="Genel Bakış"><ScrollViewer><StackPanel Margin="24"><TextBlock Text="Veritabanı karşılaştırması" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="CompanyText" Margin="0,8,0,20"/><UniformGrid Columns="4"><Border Background="#EDF5FF" Margin="0,0,12,0" Padding="18"><StackPanel><TextBlock Text="İncelenen tablo"/><TextBlock x:Name="TableCount" FontSize="32" FontWeight="Bold"/></StackPanel></Border><Border Background="#E9F7F0" Margin="0,0,12,0" Padding="18"><StackPanel><TextBlock Text="Şirkete doğrudan bağlı"/><TextBlock x:Name="ScopedCount" FontSize="32" FontWeight="Bold"/></StackPanel></Border><Border Background="#FFF3DF" Margin="0,0,12,0" Padding="18"><StackPanel><TextBlock Text="Sayı farkı olan tablo"/><TextBlock x:Name="DifferenceCount" FontSize="32" FontWeight="Bold"/></StackPanel></Border><Border Background="#F3EDFA" Padding="18"><StackPanel><TextBlock Text="İlişki incelemesi gerekli"/><TextBlock x:Name="ReviewCount" FontSize="32" FontWeight="Bold"/></StackPanel></Border></UniformGrid><TextBlock Text="Aktarım hazırlığı" FontSize="20" FontWeight="SemiBold" Margin="0,28,0,12"/><TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="25" Text="Bu sürüm gerçek SQL verilerini okur ve periyodik karşılaştırır. Başlat/Durdur düğmeleri otomatik okumayı yönetir. Veritabanlarına kayıt eklemez, güncellemez veya silmez. Aktarım motoru henüz bağlı değildir.&#10;&#10;Satır sayısı farkı aktarılacak işlem sayısı değildir. Eşit sayılar da içeriklerin aynı olduğunu kanıtlamaz. Detay tabloları ve ortak kayıtlar, şirket sahipliği doğrulandıktan sonra kapsama alınacaktır."/><Button Content="Son rapor klasörünü aç" Click="OpenReport_Click" HorizontalAlignment="Left" Margin="0,24,0,0"/></StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Tablolar ve Veriler"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,10"><Button DockPanel.Dock="Right" Content="Seçili tablonun verilerini göster" Click="Rows_Click"/><CheckBox x:Name="OnlyDifferent" DockPanel.Dock="Right" Content="Yalnız sayı farkı" VerticalAlignment="Center" Margin="16,0" Checked="Filter_Changed" Unchecked="Filter_Changed"/><TextBox x:Name="SearchBox" Width="300" HorizontalAlignment="Left" Margin="0" TextChanged="Search_Changed" ToolTip="Tablo adına göre filtrele"/></DockPanel><DataGrid x:Name="TablesGrid" Grid.Row="1"><DataGrid.Columns><DataGridTextColumn Header="Tablo" Binding="{Binding Table}" Width="*"/><DataGridTextColumn Header="Kaynak" Binding="{Binding SourceCount}" Width="100"/><DataGridTextColumn Header="Hedef" Binding="{Binding TargetCount}" Width="100"/><DataGridTextColumn Header="Fark" Binding="{Binding Difference}" Width="80"/><DataGridTextColumn Header="Durum" Binding="{Binding DisplayStatus}" Width="220"/></DataGrid.Columns></DataGrid><TextBlock Grid.Row="2" Text="Veri görünümü doğrudan CompanyId taşıyan ERP tablolarında, seçili şirkete ait ilk 200 kaydı gösterir." Margin="0,12,0,0"/></Grid></TabItem>
   <TabItem Header="Kayıt Farkları"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><WrapPanel><ComboBox x:Name="CompareTable" Width="220" SelectedIndex="0" Margin="0,0,12,0"><ComboBoxItem Content="Cari kartlar" Tag="dbo.Erp_CurrentAccount"/><ComboBoxItem Content="Stok kartları" Tag="dbo.Erp_Inventory"/></ComboBox><Button Content="Kayıtları karşılaştır" Click="Compare_Click"/><Button Content="Seçili kaydın alan farkları" Click="Detail_Click"/><Button Content="Seçilileri inceleme kuyruğuna al" Click="Stage_Click"/><Button Content="Eşleştirme sorunları" Click="Issues_Click"/></WrapPanel><TextBlock x:Name="ComparisonSummary" Grid.Row="1" Text="Önce cari veya stok kartlarını karşılaştırın." Margin="0,12" TextWrapping="Wrap"/><DataGrid x:Name="DifferencesGrid" Grid.Row="2" SelectionMode="Extended"><DataGrid.Columns><DataGridTextColumn Header="Kod" Binding="{Binding MatchKey}" Width="180"/><DataGridTextColumn Header="Durum" Binding="{Binding DisplayKind}" Width="*"/><DataGridTextColumn Header="Kaynak RecId" Binding="{Binding SourceRecId}" Width="130"/><DataGridTextColumn Header="Hedef RecId" Binding="{Binding TargetRecId}" Width="130"/></DataGrid.Columns></DataGrid><TextBlock Grid.Row="3" Margin="0,12,0,0" TextWrapping="Wrap" Text="Boş, tekrarlı veya kenar boşluklu kodlar eşleştirme dışında tutulur. Teknik kimlik/tarih alanları özetten çıkarılır. Bağlı kayıt numaraları henüz normalleştirilmez. Yalnız hedefte bulunan kayıt, silme talimatı değildir."/></Grid></TabItem>
   <TabItem Header="İnceleme Kuyruğu"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Kalıcı inceleme adayları • SQL yazma kapalı. Ön kontrol kaydın hâlâ aynı olup olmadığını SQL üzerinden yeniden okur." TextWrapping="Wrap" Margin="0,0,0,12"/><Button Content="Seçili kaydı güncel verilerle doğrula" Click="VerifyQueue_Click" HorizontalAlignment="Left" Margin="0,0,0,12"/></StackPanel><DataGrid x:Name="QueueGrid" Grid.Row="1"><DataGrid.Columns><DataGridTextColumn Header="Tablo" Binding="{Binding Table}" Width="200"/><DataGridTextColumn Header="Kod" Binding="{Binding MatchKey}" Width="160"/><DataGridTextColumn Header="Fark" Binding="{Binding Kind}" Width="*"/><DataGridTextColumn Header="Durum" Binding="{Binding DisplayStatus}" Width="250"/><DataGridTextColumn Header="Ön kontrol" Binding="{Binding VerificationText}" Width="280"/><DataGridTextColumn Header="Doğrulama zamanı" Binding="{Binding VerifiedAt}" Width="200"/></DataGrid.Columns></DataGrid></Grid></TabItem>

   <TabItem Header="Banka Fişleri"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><WrapPanel><Button Content="Banka fişlerini ve hareketlerini karşılaştır" Click="BankCompare_Click"/><CheckBox x:Name="BankOnlyDifferences" Content="Yalnız farklar / engeller" IsChecked="True" VerticalAlignment="Center" Margin="15,0" Checked="BankFilter_Changed" Unchecked="BankFilter_Changed"/></WrapPanel><TextBlock x:Name="BankSummary" Grid.Row="1" Margin="0,12" TextWrapping="Wrap" Text="Fiş başlıkları, hareketleri ve ekleri birlikte incelenir. Kaynak ve hedef oluşturan kullanıcıları ayrı gösterilir."/><DataGrid x:Name="BankGrid" Grid.Row="2"><DataGrid.Columns><DataGridTextColumn Header="Durum" Binding="{Binding Status}" Width="120"/><DataGridTextColumn Header="Fiş No" Binding="{Binding ReceiptNo}" Width="110"/><DataGridTextColumn Header="Tür" Binding="{Binding ReceiptType}" Width="50"/><DataGridTextColumn Header="Kaynak RecId" Binding="{Binding SourceRecId}" Width="110"/><DataGridTextColumn Header="Hedef RecId" Binding="{Binding TargetRecId}" Width="110"/><DataGridTextColumn Header="Kaynak kullanıcı" Binding="{Binding SourceCreator}" Width="120"/><DataGridTextColumn Header="Hedef kullanıcı" Binding="{Binding TargetCreator}" Width="120"/><DataGridTextColumn Header="Kaynak satır" Binding="{Binding SourceItems}" Width="90"/><DataGridTextColumn Header="Hedef satır" Binding="{Binding TargetItems}" Width="90"/><DataGridTextColumn Header="Fark" Binding="{Binding Differences}" Width="120"/><DataGridTextColumn Header="Eşleştirme" Binding="{Binding MatchMethod}" Width="150"/><DataGridTextColumn Header="Aktarım engeli / açıklama" Binding="{Binding BlockReason}" Width="500"/></DataGrid.Columns></DataGrid><TextBlock Grid.Row="3" Margin="0,12,0,0" TextWrapping="Wrap" Text="Eşleştirme UniqueId ile, eski kayıtlarda tür/numara/tarih ile yapılır; fiş türü/numarası çakışmaları engellenir. Kullanıcılar mevcut kayıtlardan okunur; bu, EXE'nin oluşturduğunu kanıtlamaz. Bu ekran hedefe yazmaz."/></Grid></TabItem>
   <TabItem Header="İşlem Geçmişi"><DataGrid x:Name="HistoryGrid" Margin="16"><DataGrid.Columns><DataGridTextColumn Header="Zaman" Binding="{Binding Time}" Width="190"/><DataGridTextColumn Header="İşlem" Binding="{Binding Kind}" Width="160"/><DataGridTextColumn Header="Açıklama" Binding="{Binding Message}" Width="*"/></DataGrid.Columns></DataGrid></TabItem>
   <TabItem Header="Bağlantı ve Ayarlar"><ScrollViewer><StackPanel Margin="24" MaxWidth="720" HorizontalAlignment="Left"><TextBlock Text="SQL Server hesabı" FontSize="22" FontWeight="SemiBold"/><TextBlock Margin="0,10" Text="Parola sadece bu oturumun belleğinde tutulur; dosyaya veya komut satırına yazılmaz." TextWrapping="Wrap"/><TextBlock Text="Kullanıcı adı"/><TextBox x:Name="SqlUser" Text="sa"/><TextBlock Text="Parola"/><PasswordBox x:Name="SqlPassword" Padding="8" Margin="0,5,0,16"/><TextBlock Text="Kontrol aralığı (saniye, en az 60)"/><TextBox x:Name="IntervalBox" Text="300"/><Button Content="Aralığı kaydet" Click="SaveInterval_Click" HorizontalAlignment="Left"/><TextBlock Text="Kaynak / hedef profili" FontSize="20" Margin="0,24,0,10"/><TextBox x:Name="ProfileText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinWidth="650" Height="230" VerticalScrollBarVisibility="Auto"/><TextBlock TextWrapping="Wrap" Text="Bağlantı profili profile.json dosyasından okunur. Yön: kaynak → hedef. Şirket kimliği her karşılaştırmada doğrulanır. Test ortamında TLS kullanılır; sunucu sertifika zinciri doğrulaması kapalıdır."/></StackPanel></ScrollViewer></TabItem>
  </TabControl>
  <TextBlock Grid.Row="3" Margin="0,12,0,0" Foreground="#64748B" Text="SentezSync • Yerel masaüstü uygulaması • İş verileri bu bilgisayardan dış hizmetlere gönderilmez"/>
 </Grid>
</Window>







